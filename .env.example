# Copy to .env and fill in. Never commit .env.
# Project endpoint: Foundry portal > your project > Overview
PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# A chat model with vision and structured outputs, not in deprecating state (for example gpt-4.1-mini)
MODEL_DEPLOYMENT_NAME=gpt-4.1-mini
# Optional, Lab 6 evaluators. Derived from PROJECT_ENDPOINT when empty.
AZURE_OPENAI_ENDPOINT=
# Optional, Lab 6 tracing: record prompt and response text in traces (development only)
ENABLE_SENSITIVE_DATA=false
